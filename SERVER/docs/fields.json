fields: {
    CAN NOT BE MAPPED SECTION
    "autoNumber": false,
    "createable": false, -- similar to updatable
    "updateable": false,
    "calculated": false,
    "defaultedOnCreate": true, -- will be true for audit fields

    INFO SECTION
    -- maybe we will need tooling, for ID, ObjectId, etc
    "objectId": "Id",  -- obj id from our DB or from salesforce?
    "name": "Id",
    "label": "Billing Street",
    "inlineHelpText": null,
    "calculatedFormula": null,
    "defaultValue": null, -- if null, then not set, but may be false/true for booleans
    "defaultValueFormula": null,
    "custom": false,
    "idLookup": true, -- same as external id, but the 'id' field will have externalId as false
    "relationshipName": "Owner",

    VALIDATIONS SECTION
    "picklistValues": [{ -- if not empty array, it is a picklist
        "active": true,
        "defaultValue": false,
        "label": "Prospect",
        "validFor": null,
        "value": "Prospect"
    },{...}], -- also for the info section
    "restrictedPicklist": false,
    "dependentPicklist": false,
    "externalId": false,
    "unique": false,
    "compoundFieldName": <api name of compound field this belongs to>,
    "type": "id",
    "referenceTo": [
        "Contact",
        "Lead"
    ],
    "nillable": false,
    "byteLength": 18,
    "length": 18,
    "digits": 0, -- will only make sense for certain types, e.g. 'int'>
    "scale": 0,
    "precision": 0,


    NEED TO CHECK SECTION
    "encrypted": false,

    Roll up summary fields, probably look like this:
    "createable": false,
    "calculated": true,
    "calculatedFormula": null,
    "updateable": false,
},
