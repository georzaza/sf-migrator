{
    "scripts": {
        "serve": "cross-env NODE_ENV=development nodemon src/server.js",
        "start:prod": "cross-env NODE_ENV=production node src/server.js",
        "start:test": "cross-env NODE_ENV=test node src/server.js",
        "test": "mocha",
        "test:watch": "mocha --watch",
        "migrate:dev": "cross-env NODE_ENV=development npx sequelize-cli db:migrate",
        "migrate:test": "cross-env NODE_ENV=test npx sequelize-cli db:migrate",
        "migrate:prod": "cross-env NODE_ENV=production npx sequelize-cli db:migrate",
        "migrate:status:dev": "cross-env NODE_ENV=development npx sequelize-cli db:migrate:status",
        "migrate:status:test": "cross-env NODE_ENV=test npx sequelize-cli db:migrate:status",
        "migrate:status:prod": "cross-env NODE_ENV=production npx sequelize-cli db:migrate:status",
        "seed:dev": "cross-env NODE_ENV=development npx sequelize-cli db:seed:all",
        "seed:test": "cross-env NODE_ENV=test npx sequelize-cli db:seed:all",
        "seed:prod": "cross-env NODE_ENV=production npx sequelize-cli db:seed:all",
        "seed:undo:dev": "cross-env NODE_ENV=development npx sequelize-cli db:seed:undo:all",
        "seed:undo:test": "cross-env NODE_ENV=test npx sequelize-cli db:seed:undo:all",
        "seed:undo:prod": "cross-env NODE_ENV=production npx sequelize-cli db:seed:undo:all",
        "reset:dev": "npm run seed:undo:dev && npm run migrate:dev && npm run seed:dev",
        "reset:test": "npm run seed:undo:test && npm run migrate:test && npm run seed:test",
        "reset:prod": "npm run seed:undo:prod && npm run migrate:prod && npm run seed:prod",
        "fresh:dev": "cross-env NODE_ENV=development npx sequelize-cli db:migrate:undo:all && npm run migrate:dev && npm run seed:dev",
        "fresh:test": "cross-env NODE_ENV=test npx sequelize-cli db:migrate:undo:all && npm run migrate:test && npm run seed:test",
        "fresh:prod": "cross-env NODE_ENV=production npx sequelize-cli db:migrate:undo:all && npm run migrate:prod && npm run seed:prod"
    },
    "dependencies": {
        "bcrypt": "^5.1.1",
        "cors": "^2.8.5",
        "crypto-js": "^4.2.0",
        "crypto.js": "^3.3.4",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "fs": "^0.0.1-security",
        "jsforce": "^3.6.5",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.16.2",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.7",
        "validator": "^13.15.15",
        "ws": "^8.18.1"
    },
    "devDependencies": {
        "chai": "^6.2.2",
        "cross-env": "^7.0.3",
        "mocha": "^11.7.5",
        "sequelize-cli": "^6.6.3",
        "sinon": "^21.0.1",
        "supertest": "^7.2.2"
    }
}
